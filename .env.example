HOST=0.0.0.0
PORT=8001
APP_VERSION=0.1.1

# Cloudlog base URL. Both of these forms work:
# https://cloudlog.example.com
# https://cloudlog.example.com/index.php
CLOUDLOG_BASE_URL=https://cloudlog.example.com
CLOUDLOG_API_KEY=replace-with-your-read-write-api-key
CLOUDLOG_LOGBOOK_PUBLIC_SLUG=replace-with-your-public-logbook-slug

# Optional. If omitted, the app tries to use the active station profile.
CLOUDLOG_STATION_PROFILE_ID=

# Contest defaults
CONTEST_ID=
DEFAULT_MODE=SSB
DEFAULT_OPERATOR_CALLSIGN=
DEFAULT_RST_SENT=59
DEFAULT_RST_RCVD=59
OPERATORS=
SERIAL_PAD=3
BANDS=160m,80m,40m,20m,15m,10m

# Exchange type: "serial" (default) or "cqzone" (CQ WW: RST + CQ zone).
# Example for CQ WW DX SSB from France:
#   CONTEST_ID=CQ-WW-SSB
#   EXCHANGE_TYPE=cqzone
#   MY_CQ_ZONE=14
EXCHANGE_TYPE=serial
MY_CQ_ZONE=

# Optional contest window in UTC. When both are set, dupes are checked against
# QSOs logged inside this window (local backup) instead of the whole Cloudlog
# logbook, so stations worked before the contest are not blocked.
# CQ WW DX SSB 2026: 2026-10-24T00:00:00Z -> 2026-10-25T23:59:59Z
CONTEST_START=
CONTEST_END=

# Cabrillo export (GET /api/cabrillo, built from the local backup log)
# CABRILLO_CALLSIGN defaults to the Cloudlog station profile callsign.
CABRILLO_CALLSIGN=
# SINGLE-OP, MULTI-OP or CHECKLOG
CABRILLO_CATEGORY_OPERATOR=SINGLE-OP
# ASSISTED or NON-ASSISTED
CABRILLO_CATEGORY_ASSISTED=NON-ASSISTED
# ALL, 160M, 80M, 40M, 20M, 15M, 10M
CABRILLO_CATEGORY_BAND=ALL
# HIGH, LOW or QRP
CABRILLO_CATEGORY_POWER=LOW
# ONE, TWO, LIMITED, UNLIMITED or SWL
CABRILLO_CATEGORY_TRANSMITTER=ONE
CABRILLO_NAME=
CABRILLO_EMAIL=

# Local backup log file, written after every successful QSO upload
BACKUP_LOG_FILE=data/qso-backup.ndjson

# Optional live rig frequency file in MHz, for example: 14.350
# If the file content starts with "#", the app treats it as a rig read error.
RADIO_FREQUENCY_FILE=

# Callsign lookups always try HamDB and QRZ together.
# QRZ is optional; if credentials are missing or invalid, the app keeps using HamDB.

# QRZ XML interface credentials
QRZ_USERNAME=
QRZ_PASSWORD=
# Optional. Defaults to qso_constest/<APP_VERSION> if omitted.
QRZ_AGENT=
